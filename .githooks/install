#!/bin/sh
# Wires the versioned hooks, and pins this clone's commit identity when one is
# configured. `npm install` runs it through the package.json `prepare` script;
# rerunning is harmless.
set -e
# Only act at the root of a checkout, never on a packed tarball or a dependency install.
if [ "$(git rev-parse --show-toplevel 2>/dev/null)" != "$(pwd -P)" ]; then
  exit 0
fi
. ./.githooks/identity.sh
if [ -f ./.githooks/identity.local.sh ]; then
  . ./.githooks/identity.local.sh
fi
git config core.hooksPath .githooks
# An unset identity is the default: never rewrite a contributor's own git config.
if [ -n "$GIT_IDENTITY_NAME" ] && [ -n "$GIT_IDENTITY_EMAIL" ]; then
  git config user.name "$GIT_IDENTITY_NAME"
  git config user.email "$GIT_IDENTITY_EMAIL"
fi
